generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  emailHash      String         @unique
  emailEncrypted String
  passwordHash   String
  displayName    String
  phoneEncrypted String?
  createdAt      DateTime       @default(now())
  items          Item[]
  notifications  Notification[]
  sessions       Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Item {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  title         String
  description   String
  category      String
  brand         String
  color         String
  location      String
  eventAt       DateTime
  imagePath     String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  lostMatches   Match[]  @relation("LostItem")
  foundMatches  Match[]  @relation("FoundItem")
}

model Match {
  id          String   @id @default(cuid())
  lostItemId  String
  foundItemId String
  score       Float
  status      String   @default("PENDING")
  lostItem    Item     @relation("LostItem", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem   Item     @relation("FoundItem", fields: [foundItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([lostItemId, foundItemId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  matchId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
